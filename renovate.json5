{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>giantswarm/renovate-presets:default.json5',
  ],
  // `helm/` holds a self-test fixture chart, not a real one. See helm/selftest-cluster-app/README.md.
  ignorePaths: [
    'helm/**',
  ],
  customManagers: [
    {
      description: 'Allow updating binaries in workflows installed via install-binary-action',
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+version: (?<currentValue>.*?)\\n',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
    {
      // Tool versions pinned as `workflow_call` input defaults, so a reusable workflow
      // installs the same version the calling repo pins for itself. The manager above only
      // matches `version:` keys, so these would drift silently until a consumer went red.
      description: 'Allow updating tool versions pinned as workflow_call input defaults',
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+default: \'(?<currentValue>.*?)\'\\n',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
  ],
  packageRules: [
    {
      "matchDepNames": [
        "/^giantswarm/architect$/",
      ],
      "allowedVersions": "<= 9999.0.0", // fix for bad tags in architect like '9777070'
    },
  ],
}
