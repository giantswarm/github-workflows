{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>giantswarm/renovate-presets:default.json5',
  ],
  // `helm/` holds a self-test fixture chart, not a real one. See helm/selftest-cluster-app/README.md.
  ignorePaths: [
    'helm/**',
  ],
  customManagers: [
    {
      description: 'Allow updating binaries in workflows installed via install-binary-action',
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+version: (?<currentValue>.*?)\\n',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
    {
      // Tool versions pinned as `workflow_call` input defaults, so a reusable workflow
      // installs the same version the calling repo pins for itself. The manager above only
      // matches `version:` keys, so these would drift silently until a consumer went red.
      description: 'Allow updating tool versions pinned as workflow_call input defaults',
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+default: \'(?<currentValue>.*?)\'\\n',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
    {
      description: 'Allow updating container images pinned by tag and digest in workflow env vars',
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>docker) depName=(?<depName>.*?)\\s+\\w+: .*?:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)\\n',
      ],
    },
    {
      // Tool versions pinned as `FOO_VERSION:` env vars, optionally followed by a
      // `FOO_SHA256:` line holding the release asset's checksum. With the
      // github-release-attachments datasource Renovate rewrites both lines: it finds
      // the asset behind the current checksum (via a checksums manifest, or by hashing
      // the assets) and takes that asset's checksum from the new release. The pinned
      // value must be the full release tag (`v1.7.12`), which semver-coerced accepts.
      description: 'Allow updating FOO_VERSION env pins, with an optional FOO_SHA256 release-asset checksum',
      customType: 'regex',
      managerFilePatterns: [
        '/.*\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\n\\s+\\w+_VERSION: [\'"]?(?<currentValue>[^\'"\\s]+)[\'"]?\\n(?:\\s+\\w+_SHA256: (?<currentDigest>[a-f0-9]{64})\\n)?',
      ],
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
  ],
  packageRules: [
    {
      "matchDepNames": [
        "/^giantswarm/architect$/",
      ],
      "allowedVersions": "<= 9999.0.0", // fix for bad tags in architect like '9777070'
    },
  ],
}
